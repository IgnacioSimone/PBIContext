<Window x:Class="PBIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBI Context" Height="820" Width="1420" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Ítem de navegación lateral, estilo macOS -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
            <Setter Property="FontFamily" Value="{StaticResource FontText}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource InkDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Margin="10,2" Padding="12,10"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon"
                                           FontFamily="{StaticResource FontIcon}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="15" Width="26" VerticalAlignment="Center"
                                           Foreground="{StaticResource InkFaint}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E1E1E7" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Icon" Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootShell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="RootShellShift" Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootShell" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShellShift" Y="12" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,18">
                    <TextBlock Text="PBI Context"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock Text="Documentación de modelo y reporte"
                               FontFamily="{StaticResource FontSmall}"
                               FontSize="11.5" Foreground="{StaticResource InkFaint}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="18,10,18,18" Padding="13,11"
                        Background="#E3E3E9" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="PRIVACIDAD"
                                   FontFamily="{StaticResource FontSmall}" FontSize="9.5"
                                   FontWeight="Bold" Foreground="{StaticResource InkFaint}" />
                        <TextBlock Text="Solo se lee metadata. Nunca se consulta una fila de datos."
                                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                                   Foreground="{StaticResource InkDim}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectedIndex="0" VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="Resumen"            Tag="&#xE946;" />
                    <ListBoxItem Content="Medidas DAX"        Tag="&#xE9D2;" />
                    <ListBoxItem Content="Tablas"             Tag="&#xE8A9;" />
                    <ListBoxItem Content="Columnas"           Tag="&#xE71C;" />
                    <ListBoxItem Content="Relaciones"         Tag="&#xE71B;" />
                    <ListBoxItem Content="Power Query (M)"    Tag="&#xE8B5;" />
                    <ListBoxItem Content="Uso y limpieza"     Tag="&#xE74D;" />
                    <ListBoxItem Content="Visuales y campos"  Tag="&#xE9D9;" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Column="1" Margin="28,26,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="SectionTitle" Text="Medidas DAX"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="StatusText"
                               FontFamily="{StaticResource FontSmall}" FontSize="12"
                               Foreground="{StaticResource InkDim}"
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Sin conexión — abrí esta herramienta desde Power BI Desktop." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ChoosePbixButton" Content="Abrir .pbix"
                            Style="{StaticResource SoftButton}" Click="ChoosePbixButton_Click" />
                    <Button x:Name="ExportCsvButton" Content="Exportar CSV"
                            Style="{StaticResource SoftButton}" Click="ExportCsvButton_Click" />
                    <Button x:Name="ExportWordButton" Content="Exportar a Word"
                            Style="{StaticResource SoftButton}" Click="ExportWordButton_Click" />
                    <Button x:Name="ExportAiButton" Content="Contexto para IA"
                            Style="{StaticResource AccentButton}" Click="ExportAiButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid x:Name="ContentHost">
                    <!-- 0 · Resumen -->
                    <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" Padding="4">
                        <StackPanel x:Name="SummaryStack" Margin="26,24,26,24" />
                    </ScrollViewer>

                    <!-- 1 · Medidas -->
                    <DataGrid x:Name="MeasuresGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TABLA" Binding="{Binding Table}" Width="160" />
                            <DataGridTextColumn Header="MEDIDA" Binding="{Binding Name}" Width="230" />
                            <DataGridTextColumn Header="CARPETA" Binding="{Binding DisplayFolder}" Width="150" />
                            <DataGridTextColumn Header="DAX" Binding="{Binding Expression}" Width="*"
                                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                            <DataGridTextColumn Header="FORMATO" Binding="{Binding FormatString}" Width="110" />
                            <DataGridCheckBoxColumn Header="OCULTA" Binding="{Binding IsHidden}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 2 · Tablas -->
                    <DataGrid x:Name="TablesGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TABLA" Binding="{Binding Name}" Width="300" />
                            <DataGridTextColumn Header="COLUMNAS" Binding="{Binding ColumnCount}" Width="110" />
                            <DataGridTextColumn Header="MEDIDAS" Binding="{Binding MeasureCount}" Width="110" />
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="*" />
                            <DataGridCheckBoxColumn Header="OCULTA" Binding="{Binding IsHidden}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3 · Columnas -->
                    <DataGrid x:Name="ColumnsGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TABLA" Binding="{Binding Table}" Width="210" />
                            <DataGridTextColumn Header="COLUMNA" Binding="{Binding Name}" Width="230" />
                            <DataGridTextColumn Header="TIPO DE DATO" Binding="{Binding DataType}" Width="140" />
                            <DataGridTextColumn Header="ORIGEN" Binding="{Binding ColumnType}" Width="140" />
                            <DataGridTextColumn Header="CARPETA" Binding="{Binding DisplayFolder}" Width="130" />
                            <DataGridTextColumn Header="DAX / COLUMNA ORIGEN" Binding="{Binding DaxOrSource}" Width="*"
                                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                            <DataGridCheckBoxColumn Header="OCULTA" Binding="{Binding IsHidden}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 4 · Relaciones -->
                    <DataGrid x:Name="RelationshipsGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DESDE" Binding="{Binding FromTable}" Width="180" />
                            <DataGridTextColumn Header="COLUMNA" Binding="{Binding FromColumn}" Width="180" />
                            <DataGridTextColumn Header="HACIA" Binding="{Binding ToTable}" Width="180" />
                            <DataGridTextColumn Header="COLUMNA" Binding="{Binding ToColumn}" Width="180" />
                            <DataGridTextColumn Header="CARDINALIDAD" Binding="{Binding Cardinality}" Width="150" />
                            <DataGridTextColumn Header="FILTRO CRUZADO" Binding="{Binding CrossFilterBehavior}" Width="*" />
                            <DataGridCheckBoxColumn Header="ACTIVA" Binding="{Binding IsActive}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 5 · Power Query (M) -->
                    <DataGrid x:Name="PowerQueryGrid" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Kind}" Width="140" />
                            <DataGridTextColumn Header="CÓDIGO M" Binding="{Binding MCode}" Width="*"
                                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 6 · Uso y limpieza -->
                    <Grid x:Name="UsagePane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,14,16,4">
                            <CheckBox x:Name="UsageOnlyUnusedCheck" Content="Mostrar solo objetos sin uso"
                                      FontFamily="{StaticResource FontText}" FontSize="12.5"
                                      Foreground="{StaticResource InkDim}" VerticalAlignment="Center"
                                      Checked="UsageFilter_Changed" Unchecked="UsageFilter_Changed" />
                            <TextBlock FontFamily="{StaticResource FontSmall}" FontSize="11"
                                       Foreground="{StaticResource InkFaint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Cruza visuales del reporte, dependencias DAX y relaciones. No sigue dependencias de Power Query entre consultas (M) — una tabla auxiliar que solo alimenta a otra vía M puede figurar como &quot;sin uso&quot; sin serlo. Confirmá antes de borrar." />
                        </StackPanel>

                        <DataGrid x:Name="UsageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Kind}" Width="90" />
                                <DataGridTextColumn Header="TABLA" Binding="{Binding Table}" Width="170" />
                                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="200">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Sin uso — candidata a eliminar">
                                                    <Setter Property="Foreground" Value="#C0392B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Solo uso interno">
                                                    <Setter Property="Foreground" Value="#B7791F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="En uso">
                                                    <Setter Property="Foreground" Value="#1C7C4C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="DEPENDE DE" Binding="{Binding DependsOnText}" Width="*"
                                                    FontFamily="{StaticResource FontMono}" FontSize="11" />
                                <DataGridTextColumn Header="USADO POR" Binding="{Binding UsedByText}" Width="*"
                                                    FontFamily="{StaticResource FontMono}" FontSize="11" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 7 · Visuales -->
                    <Grid x:Name="VisualsPane" Visibility="Collapsed">
                        <DataGrid x:Name="VisualsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PÁGINA" Binding="{Binding Page}" Width="200" />
                                <DataGridTextColumn Header="VISUAL" Binding="{Binding VisualType}" Width="240" />
                                <DataGridTextColumn Header="TÍTULO" Binding="{Binding Title}" Width="200" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding FieldKind}" Width="100" />
                                <DataGridTextColumn Header="TABLA" Binding="{Binding Table}" Width="180" />
                                <DataGridTextColumn Header="CAMPO" Binding="{Binding Field}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vacío: dice qué está pasando en vez de mostrar una grilla en blanco -->
                        <Border x:Name="VisualsEmptyState" Background="{StaticResource CardBg}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FontIcon}"
                                           FontSize="42" Foreground="{StaticResource InkFaint}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="VisualsEmptyTitle" Text="Buscando el archivo del reporte…"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                           Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="VisualsEmptyBody"
                                           Text="Los visuales y sus campos viven dentro del archivo .pbix, no en el modelo en memoria."
                                           FontFamily="{StaticResource FontText}" FontSize="12.5"
                                           Foreground="{StaticResource InkDim}" HorizontalAlignment="Center"
                                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Elegir archivo .pbix…"
                                        Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                                        Margin="0,20,0,0" Click="ChoosePbixButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Estado vacío del modelo: cubre las 5 secciones del modelo (Medidas/Tablas/Columnas/
                         Relaciones/Power Query), con título y cuerpo que ApplyNavState adapta según si no
                         hay ninguna conexión todavía o si esa sección puntual no tiene filas. -->
                    <Border x:Name="ModelEmptyState" Background="{StaticResource CardBg}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                            <TextBlock x:Name="ModelEmptyIcon" Text="&#xE9D2;" FontFamily="{StaticResource FontIcon}"
                                       FontSize="42" Foreground="{StaticResource InkFaint}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="ModelEmptyTitle" Text="Sin modelo conectado"
                                       FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />
                            <TextBlock x:Name="ModelEmptyBody"
                                       Text="Abrí tu tablero en Power BI Desktop y lanzá PBI Context desde la pestaña Herramientas externas. Ahí se llenan medidas, tablas, columnas y relaciones."
                                       FontFamily="{StaticResource FontText}" FontSize="12.5"
                                       Foreground="{StaticResource InkDim}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
