<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PBIContext</AssemblyName>
    <AssemblyTitle>PBI Context</AssemblyTitle>
    <Product>PBI Context</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
  </ItemGroup>

  <!-- El SDK incluye .cs recursivamente por default; sin esto, el proyecto de tests
       (subcarpeta PBIExplorer.Tests) se compilaría también acá, sin las referencias
       de xUnit. -->
  <ItemGroup>
    <Compile Remove="PBIExplorer.Tests\**" />
    <None Remove="PBIExplorer.Tests\**" />
    <EmbeddedResource Remove="PBIExplorer.Tests\**" />
  </ItemGroup>

</Project>
